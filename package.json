{
	"name": "flop",
	"version": "0.0.0",
	"license": "UNLICENSED",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "vite",
		"check": "biome check README.md package.json vite.config.ts src worker",
		"dev:beacon": "bunx wrangler dev --config worker/wrangler.toml",
		"typecheck": "tsc",
		"build": "vite build",
		"deploy:beacon": "bunx wrangler deploy --config worker/wrangler.toml",
		"preview": "vite preview --port 31337",
		"sculpt": "vite --open /src/fixtures/index.html"
	},
	"dependencies": {
		"solid-js": "1"
	},
	"devDependencies": {
		"@biomejs/biome": "2",
		"@types/node": "26.1.0",
		"baseline-browser-mapping": "2.10.41",
		"typescript": "6",
		"vite": "8",
		"vite-plugin-solid": "2",
		"wrangler": "^4.108.0"
	}
}
