{
	"name": "flop",
	"version": "0.0.0",
	"license": "UNLICENSED",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"scripts": {
		"dev": "vite",
		"check": "biome check README.md package.json tsconfig.json vite.config.ts contracts src test worker",
		"dev:beacon": "bunx wrangler dev --config worker/wrangler.toml",
		"typecheck": "tsc && tsc -p worker",
		"build": "vite build",
		"deploy:beacon": "bunx wrangler deploy --config worker/wrangler.toml",
		"preview": "vite preview --port 31337",
		"sculpt": "vite --open /src/fixtures/index.html",
		"test": "bun --conditions=browser test"
	},
	"dependencies": {
		"solid-js": "1"
	},
	"devDependencies": {
		"@biomejs/biome": "2",
		"@cloudflare/workers-types": "5",
		"@types/node": "26",
		"baseline-browser-mapping": "2",
		"typescript": "7",
		"vite": "8",
		"vite-plugin-solid": "2",
		"wrangler": "4"
	}
}
